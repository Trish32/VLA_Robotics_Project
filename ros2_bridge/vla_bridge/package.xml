<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vla_bridge</name>
  <version>0.1.0</version>
  <description>
    ROS2 bridge to a remote VLA policy server (GR00T N1.6 or DiffusionVLA).
    Contains no torch: the model runs on a GPU host behind GR00T's ZMQ PolicyServer,
    and this package only gathers observations and republishes action chunks.
  </description>
  <maintainer email="trishlee3032@gmail.com">Trish</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>builtin_interfaces</depend>
  <!-- DROID-SLAM node only: odometry output and the map -> camera_link transform. -->
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
