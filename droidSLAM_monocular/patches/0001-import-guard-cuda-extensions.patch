+# PATCH: these were module-scope imports of CUDA-only extensions, so importing
+# droid_net.py at all required lietorch + droid_backends + torch_scatter — none of which
+# build on Apple Silicon. But DroidNet.__init__ touches none of them: it builds only
+# BasicEncoder / ConvGRU / UpdateModule / GraphAgg, all plain PyTorch. Guarding at the
+# use site therefore makes the checkpoint loadable locally while leaving the SLAM path
+# unchanged.
+#
+# scatter_mean IS substituted (exact index arithmetic, validated in tests/).
+# lietorch and BA are NOT: they resolve to raise-on-use placeholders, because a stub
+# returning plausible shapes would silently corrupt every pose. See ../compat.py.
+import sys as _sys
+from pathlib import Path as _Path
+
+_sys.path.insert(0, str(_Path(__file__).resolve().parents[2]))
+from compat import try_import_lietorch, try_import_scatter  # noqa: E402
+
+_lietorch, _HAS_LIETORCH = try_import_lietorch()
+SE3 = _lietorch.SE3 if _HAS_LIETORCH else _lietorch
+scatter_mean, _, _HAS_SCATTER = try_import_scatter()
+
+if _HAS_LIETORCH:
+    from geom.ba import BA
+    import geom.projective_ops as pops
+    from geom.graph_utils import graph_to_edge_list, keyframe_indicies
+else:  # the SLAM path needs lietorch; the network alone does not
+    from compat import missing_extension, LIETORCH_WHY
+
+    BA = missing_extension("geom.ba.BA", LIETORCH_WHY)
+    pops = missing_extension("geom.projective_ops", LIETORCH_WHY)
+    graph_to_edge_list = missing_extension("graph_to_edge_list", LIETORCH_WHY)
+    keyframe_indicies = missing_extension("keyframe_indicies", LIETORCH_WHY)
+# /PATCH
 
 
