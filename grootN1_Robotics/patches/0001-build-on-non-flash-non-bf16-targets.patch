+# PATCH: see the call sites below. Upstream asserted flash_attention_2 exactly;
+# this widens it to the implementations transformers supports for these models,
+# so the backbone can be built on CPU/MPS/T4 for local correctness work.
+_SUPPORTED_ATTN = ("flash_attention_2", "sdpa", "eager")
+
+
+def _assert_supported_attn(name: str, impl: str) -> None:
+    assert impl in _SUPPORTED_ATTN, (
+        f"{name} attn_implementation must be one of {_SUPPORTED_ATTN}, got {impl!r}"
+    )
+    if impl != "flash_attention_2":
+        logger.warning_once(
+            f"{name} is running with attn_implementation={impl!r}; upstream ships "
+            "flash_attention_2. Same math, different kernel -- but re-check numerics "
+            "against the flash path on CUDA before trusting a metric."
+        )
+
+
+# /PATCH
