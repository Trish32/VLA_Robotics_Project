+# PATCH: see the call site in Siglip2Attention.forward.
+#
+# Eagle packs several images into one sequence and communicates the layout ONLY through
+# `seq_len_list`. That argument is read exclusively by
+# `flash_attention_forward_for_packing`, which turns it into `cu_seqlens` for
+# `flash_attn_varlen_func` -- i.e. block-diagonal attention, one block per image. The
+# stock `sdpa_attention_forward` / `eager_attention_forward` accept `**kwargs`, silently
+# discard `seq_len_list`, and with `attention_mask=None` attend densely across the whole
+# packed sequence. That is a different function, not a numerical tolerance: image A's
+# tokens attend to image B.
+#
+# This builds the additive mask that reproduces the flash path's semantics for the dense
+# backends. Cost is O(total_len^2) and it rules out PyTorch's flash SDPA backend (which
+# supports only no-mask or causal), leaving memory-efficient -- acceptable, since the
+# sm_75 targets that need this path have no flash backend either way. At training scale
+# the better route is torch.nn.attention.flex_attention with a block mask, which skips
+# fully-masked blocks instead of materialising them.
+def _build_packing_mask(seq_len_list, total_len, device, dtype):
+    """Additive mask permitting attention only within an image. None if unnecessary."""
+    if not seq_len_list or len(seq_len_list) <= 1:
+        return None  # single image -- dense attention is already correct
+    if sum(seq_len_list) != total_len:
+        # Layout we do not understand; refuse rather than silently mask the wrong spans.
+        raise ValueError(
+            f"seq_len_list sums to {sum(seq_len_list)} but sequence length is "
+            f"{total_len}; cannot build the packing mask"
+        )
+    mask = torch.full((total_len, total_len), torch.finfo(dtype).min,
+                      device=device, dtype=dtype)
+    start = 0
+    for n in seq_len_list:
+        mask[start:start + n, start:start + n] = 0.0
+        start += n
+    return mask[None, None]
+
+
+# /PATCH
