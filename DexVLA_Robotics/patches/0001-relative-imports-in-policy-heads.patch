+# PATCH: these four were absolute imports of a TOP-LEVEL package named `models`
+# (`from models.transformer_diffusion... import *`). That only resolves if
+# `policy_heads/` itself is on sys.path, and it claims the generic name `models`
+# globally -- which collides with anything else in the process that has a `models`
+# package. `pip install -e policy_heads` does not fix it either: `policy_heads/models/`
+# has no __init__.py, so setuptools' find_packages() never sees it.
+#
+# Relative imports resolve through the implicit namespace package without needing
+# __init__.py files and without taking a global name.
+from .models.transformer_diffusion.modeling_scaledp import *  # noqa: F401,F403
+from .models.transformer_diffusion.configuration_scaledp import *  # noqa: F401,F403
+from .models.unet_diffusion.modeling_unet_diffusion import *  # noqa: F401,F403
+from .models.unet_diffusion.configuration_unet_diffusion import *  # noqa: F401,F403
+# /PATCH
